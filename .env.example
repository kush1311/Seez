# --- Seezar dashboard ---
SEEZAR_DASHBOARD_URL=https://seezar-dashboard.seez.dev
SEEZAR_EMAIL=your_account@example.com
SEEZAR_PASSWORD=your_password

# --- Gmail IMAP, for automated one-time-code retrieval ---
# Requires 2-Step Verification, then an app password from
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
OTP_SENDER_FILTER=seez.co
OTP_TIMEOUT_SECONDS=90
OTP_MAX_AGE_SECONDS=180

# --- Browser ---
HEADLESS_BROWSER=false

# --- OpenRouter, for Scenario III topic analysis ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
